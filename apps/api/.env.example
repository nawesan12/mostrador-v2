# Configuración de la API Go (cmd/api, cmd/worker, cmd/mostradorctl).
# En desarrollo no hace falta nada: los valores por defecto apuntan al Postgres de infra/compose.dev.yml.

# desarrollo | staging | produccion
MOSTRADOR_ENTORNO=desarrollo
MOSTRADOR_DIRECCION=:4000

# Una URL por rol. Fuera de desarrollo, las que use cada comando son obligatorias.
MOSTRADOR_BASE_DE_DATOS=postgres://mostrador_app@127.0.0.1:5440/mostrador_dev?sslmode=disable
MOSTRADOR_BASE_DE_DATOS_WORKER=postgres://mostrador_worker@127.0.0.1:5440/mostrador_dev?sslmode=disable
MOSTRADOR_BASE_DE_DATOS_MIGRADOR=postgres://mostrador_migrador@127.0.0.1:5440/mostrador_dev?sslmode=disable
MOSTRADOR_BASE_DE_DATOS_ADMIN=postgres://mostrador@127.0.0.1:5440/mostrador?sslmode=disable

# Claves de los roles para el bootstrap (vacías en desarrollo).
MOSTRADOR_CLAVE_MIGRADOR=
MOSTRADOR_CLAVE_APP=
MOSTRADOR_CLAVE_WORKER=
MOSTRADOR_CLAVE_STAFF=

# Tests: superusuario del Postgres de prueba.
MOSTRADOR_BASE_DE_DATOS_TEST=postgres://mostrador@127.0.0.1:5440/mostrador?sslmode=disable

# Cuentas y mails.
# URL pública del sitio (links de los mails). En desarrollo: http://localhost:5173.
MOSTRADOR_SITIO=https://mostrador.iamnaw.dev
# Clave compartida con el BFF (SvelteKit, secreto CLAVE_BFF del worker). Obligatoria fuera de desarrollo.
MOSTRADOR_CLAVE_BFF=
# Resend (producción). Obligatoria fuera de desarrollo; en desarrollo los mails van a Mailpit.
MOSTRADOR_RESEND_CLAVE=
MOSTRADOR_CORREO_DE=Mostrador <hola@mostrador.iamnaw.dev>
# Bandeja del equipo (consultas de ventas, partners, arrepentimientos). Vacía: no se avisa.
MOSTRADOR_CORREO_EQUIPO=
# SMTP de desarrollo (Mailpit, http://localhost:8026).
MOSTRADOR_SMTP=127.0.0.1:1026

# Ingreso con proveedores (vacío: apagado). Redirect a cargar en cada uno:
#   <MOSTRADOR_SITIO>/ingresar/<google|mercadopago|mercadolibre>/vuelta
MOSTRADOR_GOOGLE_CLIENT_ID=
MOSTRADOR_GOOGLE_SECRETO=
MOSTRADOR_MP_CLIENT_ID=
MOSTRADOR_MP_SECRETO=
MOSTRADOR_ML_CLIENT_ID=
MOSTRADOR_ML_SECRETO=
# Tiendanube (app de socio, para importar tiendas): partners.tiendanube.com
MOSTRADOR_TN_CLIENT_ID=
MOSTRADOR_TN_SECRETO=
# WhatsApp Cloud de la plataforma (links de ingreso y contraseña). Plantillas de utilidad con botón de
# link "<MOSTRADOR_SITIO>/ingresar?{{1}}": mostrador_ingreso y mostrador_clave. En desarrollo, al log.
MOSTRADOR_WHATSAPP_TOKEN=
MOSTRADOR_WHATSAPP_NUMERO_ID=
