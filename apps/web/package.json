{
	"name": "@mostrador/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "sh -c 'set -a; [ -f .dev.vars ] && . ./.dev.vars; set +a; exec \"$0\" \"$@\"' vite dev --port 5173",
		"build": "vite build",
		"preview": "wrangler d1 migrations apply mostrador-sandbox --local >/dev/null && wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen": "wrangler types && sed -i.bak '/mainModule: typeof import/d' worker-configuration.d.ts && rm -f worker-configuration.d.ts.bak",
		"test": "vitest --run --project server",
		"test:unit": "vitest --project server",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "bun run build && wrangler deploy",
		"db:migrar": "CI=true wrangler d1 migrations apply mostrador-sandbox --remote",
		"db:migrar:local": "wrangler d1 migrations apply mostrador-sandbox --local",
		"test:e2e:api": "playwright test -c playwright.api.config.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.17",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.100",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.8",
		"wrangler": "^4.151.2"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@mostrador/contrato": "workspace:*",
		"bits-ui": "^2.19.5",
		"drizzle-orm": "^0.45.4",
		"lenis": "^1.3.27",
		"valibot": "^1.5.0"
	}
}
