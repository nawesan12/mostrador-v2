{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mostrador",
	"account_id": "ce736d18d9f37624e453e7b3f9aa96a2",
	"compatibility_date": "2026-10-18",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "mostrador.iamnaw.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	// Sandbox de la demo (DATA_SOURCE=sandbox). En desarrollo se usa la D1 local (sin "remote"):
	// las pruebas nunca tocan la base real.
	"d1_databases": [
		{
			"binding": "SANDBOX",
			"database_name": "mostrador-sandbox",
			"database_id": "9efb42e6-6750-4f05-9a89-00731e798113",
			"migrations_dir": "migraciones-sandbox"
		},
		{
			"binding": "ESTADO",
			"database_name": "mostrador-estado",
			"database_id": "4d1f0082-f683-4f1c-83f5-cdbbdc0b97d2",
			"migrations_dir": "migraciones-estado"
		}
	],
	// Fotos de productos (lib/server/archivos.ts, con topes). En desarrollo, el R2 local.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "mostrador-files" }],
	// Hornero: Workers AI (siempre remoto). En desarrollo y en las pruebas no se llama: el preview
	// corre con --local y HORNERO=simulado.
	"ai": { "binding": "AI", "remote": true },
	"vars": {
		"PUBLIC_SITE_URL": "https://mostrador.iamnaw.dev",
		// sandbox: la demo pública con datos por visitante en D1. api: la API Go del VPS.
		"DATA_SOURCE": "sandbox",
		// URL de la API Go cuando DATA_SOURCE=api (VPS). Vacía en la demo.
		"API_URL": "",
		// Hornero: workers-ai (el modelo) o simulado (respuestas armadas, sin llamar al modelo).
		"HORNERO": "workers-ai"
	}
}
