{
	"name": "mostrador",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/web",
		"apps/correo",
		"apps/jobs",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --cwd apps/web run dev",
		"build": "bun --cwd apps/web run build",
		"check": "bun --cwd apps/web run check",
		"lint": "bun --cwd apps/web run lint",
		"test": "bun --cwd apps/web run test",
		"test:e2e": "bun --cwd apps/web run test:e2e",
		"api:dev": "cd apps/api && go run ./cmd/api",
		"api:test": "cd apps/api && go test -race ./...",
		"db:up": "docker compose -f infra/compose.dev.yml up -d",
		"db:down": "docker compose -f infra/compose.dev.yml down",
		"api:bootstrap": "cd apps/api && go run ./cmd/mostradorctl bootstrap",
		"api:migrar": "cd apps/api && go run ./cmd/mostradorctl migrar",
		"api:worker": "cd apps/api && go run ./cmd/worker",
		"contrato:gen": "cd packages/contrato && bunx openapi-typescript openapi.yaml -o src/esquema.ts"
	}
}
